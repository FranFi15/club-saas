PORT=5000
SUPER_ADMIN_URL=http://localhost:4000
INTERNAL_ADMIN_API_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=
# Secreto dedicado para QR de ingreso (obligatorio en producción)
CLUB_ENTRY_TOKEN_SECRET=

# Sentry (opcional en local; recomendado en producción)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Mercado Pago: pagos del club ---
# Fallback global (opcional si cada club usa OAuth). Preferí OAuth por club.
MERCADOPAGO_ACCESS_TOKEN=

# OAuth Authorization code + PKCE (recomendado)
# 1) Creá app en https://www.mercadopago.com.ar/developers/panel/app
# 2) En la app → OAuth / Credenciales: copiá Client ID y Client Secret
# 3) Redirect URI (debe coincidir EXACTO con la URL registrada en MP):
#    http://TU_IP:5000/api/mercadopago/oauth/callback
#    En producción: https://tu-dominio.com/api/mercadopago/oauth/callback
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_OAUTH_REDIRECT_URI=http://192.168.0.128:5000/api/mercadopago/oauth/callback
# Secreto anti-CSRF (mín. 16 chars). Generar: npm run mp:oauth-secret
MP_OAUTH_STATE_SECRET=
MERCADOPAGO_OAUTH_USE_PKCE=true
# Secreto de Webhooks (Your integrations → Webhooks → Secret). Obligatorio en producción.
MP_WEBHOOK_SECRET=

# Al arrancar, registra seller id de MP en Super para clubs ya vinculados (webhooks multi-tenant).
# MP_SELLER_BACKFILL_ON_START=false

# URL pública del backend (webhooks MP). Misma base que el redirect sin path.
PUBLIC_API_URL=http://192.168.0.128:5000
BACKEND_URL=http://192.168.0.128:5000

# Vercel / web app URL (CORS + MP OAuth return). No trailing slash.
# Web: https://app.hermesclubapp.com
# Varios orígenes: https://app.hermesclubapp.com,https://preview.vercel.app
FRONTEND_URL=https://app.hermesclubapp.com

# --- Crons multi-tenant (requieren SUPER_ADMIN_URL + INTERNAL_ADMIN_API_KEY) ---
ENABLE_SESSION_CRON=true
SESSION_CRON_SCHEDULE=0 3 * * *
ENABLE_PAYMENT_CRON=true
PAYMENT_CRON_SCHEDULE=0 6 1 * *
ENABLE_OVERDUE_CRON=true
OVERDUE_CRON_SCHEDULE=0 4 * * *
ENABLE_PAYMENT_REMINDER_CRON=true
PAYMENT_REMINDER_CRON_SCHEDULE=0 10 * * *
# Opcional: correr una vez al iniciar el servidor (útil para probar en Render)
# SESSION_CRON_RUN_ON_START=true
# PAYMENT_CRON_RUN_ON_START=true
# OVERDUE_CRON_RUN_ON_START=true
# PAYMENT_REMINDER_CRON_RUN_ON_START=true

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
