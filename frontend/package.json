{
  "name": "frontend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --lan",
    "android": "expo start --lan --android",
    "ios": "expo start --lan --ios",
    "web": "expo start --lan --web",
    "build:web": "expo export --platform web",
    "build:android": "npx eas-cli build --platform android --profile production",
    "build:ios": "npx eas-cli build --platform ios --profile production",
    "build:mobile": "npx eas-cli build --platform all --profile production",
    "build:preview:android": "npx eas-cli build --platform android --profile preview",
    "build:preview:ios": "npx eas-cli build --platform ios --profile preview",
    "submit:android": "npx eas-cli submit --platform android --profile internal --latest",
    "submit:android:production": "npx eas-cli submit --platform android --profile production --latest",
    "submit:ios": "npx eas-cli submit --platform ios --profile production --latest",
    "submit:mobile": "npx eas-cli submit --platform all --profile production --latest"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/slider": "5.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/material-top-tabs": "^7.6.16",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.11",
    "@sentry/react-native": "~7.11.0",
    "axios": "^1.15.0",
    "cross-spawn": "^7.0.6",
    "expo": "^57.0.0",
    "expo-build-properties": "~57.0.16",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-image-picker": "~57.0.15",
    "expo-navigation-bar": "~57.0.2",
    "expo-notifications": "~57.0.16",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-video": "~57.0.3",
    "hoist-non-react-statics": "^3.3.2",
    "lodash.debounce": "^4.0.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pager-view": "8.0.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1"
  },
  "private": true,
  "overrides": {
    "react": "19.2.3"
  }
}
