{
  "name": "frontend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --lan",
    "android": "expo start --lan --android",
    "ios": "expo start --lan --ios",
    "web": "expo start --lan --web",
    "build:web": "expo export --platform web",
    "build:android": "npx eas-cli build --platform android --profile production",
    "build:ios": "npx eas-cli build --platform ios --profile production",
    "build:mobile": "npx eas-cli build --platform all --profile production",
    "build:preview:android": "npx eas-cli build --platform android --profile preview",
    "build:preview:ios": "npx eas-cli build --platform ios --profile preview",
    "submit:android": "npx eas-cli submit --platform android --profile internal --latest",
    "submit:android:production": "npx eas-cli submit --platform android --profile production --latest",
    "submit:ios": "npx eas-cli submit --platform ios --profile production --latest",
    "submit:mobile": "npx eas-cli submit --platform all --profile production --latest"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/slider": "5.2.1",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/material-top-tabs": "^7.6.16",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.11",
    "@sentry/react-native": "~8.28.0",
    "axios": "^1.15.0",
    "cross-spawn": "^7.0.6",
    "expo": "~58.0.17",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.6",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.12",
    "hoist-non-react-statics": "^3.3.2",
    "lodash.debounce": "^4.0.8",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-pager-view": "9.0.7",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "^0.13.0"
