{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "framework": null,
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/.well-known/(.*)", "destination": "/.well-known/$1" },
    { "source": "/pago/ok", "destination": "/pago-return.html" },
    { "source": "/pago/error", "destination": "/pago-return.html" },
    { "source": "/pago/pendiente", "destination": "/pago-return.html" },
    { "source": "/((?!\\.well-known/).*)", "destination": "/index.html" }
  ]
}
