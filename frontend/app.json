{
  "expo": {
    "name": "Hermes Club App",
    "slug": "hermes-club-app",
    "scheme": "clubapp",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icono-app.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icono-app.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hermesclubapp.app",
      "buildNumber": "3"
    },
    "android": {
      "package": "com.hermesclubapp.app",
      "versionCode": 9,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/androidicon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": true,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "name": "Hermes Club App",
      "favicon": "./assets/icono-app.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-video",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permite escanear el QR de ingreso de socios al club.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite subir fotos de comprobantes de pago y documentación del club.",
          "cameraPermission": "Permite tomar fotos para comprobantes y documentación del club."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#150224",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {}
  }
}
